<div style="display: flex; justify-content: center; align-items: center;">
    <div class="contenedorIniciar">
        <div class="contenedorFormulario">
            <div class="registrarUsuario">
                 <form class="formularioRegistrarUsuario" action="/registro" method="POST">
                    <h1>Registro</h1>
                    <div class="contenedorDiv">
                        <div>
                            <label for="nombre">Nombre</label>
                            <input style="margin-left: 87px;" id="nombre" name="nombre" type="text" placeholder="Ej: Manfred" required>
                        </div>
                        <div>
                            <label for="apellidos">Apellidos</label>
                            <input style="margin-left: 75px;" id="apellidos" name="apellidos" type="text" placeholder="Ej: Lagos Rodríguez" required>
                        </div>
                        <div>
                            <label for="correo">Correo electrónico</label>
                            <input style="margin-left: 5px;" id="correo" name="correo" type="email" placeholder="Ej: manfred@gmail.com" required>
                        </div>
                        <div>
                            <label for="usuario">Usuario</label>
                            <input style="margin-left: 88px;" id="usuario" name="usuario" type="text" placeholder="Ej: mlagos" required>
                        </div>
                        <div>
                            <label for="password">Contraseña</label>
                            <input style="margin-left: 60px;" id="contrasenia" name="contrasenia" type="password" placeholder="Ingrese su contraseña" required>
                        </div>
                        <div>
                            <label for="rol">Rol</label>
                            <select style="margin-left: 122px;" id="rol" name="rol" required>
                                <option value="padre">Padre</option>
                                <option value="docente">Docente</option>
                            </select>
                        </div>

                    </div>
                    <button id="btnRegistrarUsuario" type="submit">Registrar</button>
                </form>
                <button id="btnVolverInicio">Volver</button>
            </div>
        
        </div>
        <div class="contenedorFormulario">
            <div class="iniciarUsuaro">
                <h1>Iniciar Sesión</h1>
                <div class="inputIngresar">
                    <label for="usuario">Usuario: </label>
                    <div class="contenedorUsuario">
                        <img src="/images/avatar.png" alt="Avatar">
                        <input name="usuario" id="inputUsuarioIniciar" type="text" placeholder="Ejemplo: manfred.lagos">
                    </div>
                    <label for="contrasenia">Contraseña: </label>
                    <div class="contenedorContrasenia">
                        <img src="/images/cerrar-con-llave.png" alt="Avatar">
                        <input name="contrasenia" id="inputContraseniaIniciar" type="password" placeholder="Ingrese su contraseña">
                        <img id="imgMostrarContrasenia" src="/images/invisible.png" alt="ojo-invisible" onclick="mostrarContrasenia()">
                        <img id="imgOcultarContrasenia" src="/images/ojo.png" alt="ojo" onclick="ocultarContrasenia()">
                    </div> 
                </div>
                <button id="btnIniciar">Iniciar</button>
                <button id="enlaceRegistrar">Registrar</button>
            </div>
        </div>

        <div class="contenedorSaludo">
            <div class="saludoIniciar saludo">
                <div class="mensajeIngresar">
                    <h1>Bienvenido</h1>
                    <p>Página de materiales escolares del ministerio de educación pública</p>
                    <img src="/images/fondoIngresar.png" alt="imagenEstudiantes">
                </div>
                <div class="mensajeIngresarLogo">
                    <img src="/images/logo_mep_dorado.png" alt="logoMepRegistro">
                </div>
            </div>
            <div class="saludoRegistrar saludo">
                <div class="mensajeRegistrar">
                    <h1>Página de registro</h1>
                    <p>En este apartado podrá registrar usuarios en la página</p>
                    <img src="/images/fondoIngresar.png" alt="imagenEstudiantes">
                </div>
                <div class="mensageRegistrarLogo">
                    <img src="/images/logo_mep_dorado.png" alt="logoMepRegistro">
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/usuario_mep-listar.js"></script>
<script src="/js/usuario-iniciar.js"></script>

