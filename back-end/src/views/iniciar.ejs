<div style="display: flex; justify-content: center; align-items: center;">
    <div class="contenedorIniciar">
        <div class="contenedorFormulario">
            <div class="registrarUsuario" action="/registro" method="POST">
                <h1>Registro</h1>
                <div class="contenedorDiv">
                    <div>
                        <label for="nombre">Nombre</label>
                        <input id="nombre" name="nombre" type="text" placeholder="Ej: Manfred" required>
                    </div>
                    <div>
                        <label for="apellidos">Apellidos</label>
                        <input id="apellidos" name="apellidos" type="text" placeholder="Ej: Lagos Rodríguez">
                    </div>
                    <div>
                        <label for="correo">Correo electrónico</label>
                        <input id="correo" name="correo" type="email" placeholder="Ej: manfred@gmail.com" required>
                    </div>
                    <div>
                        <label for="usuario">Usuario</label>
                        <input id="usuario" name="usuario" type="text" placeholder="Ej: mlagos" required>
                    </div>
                    <div>
                        <label for="password">Contraseña</label>
                        <input id="password" name="password" type="password" placeholder="********" required>
                    </div>
                </div>
                <button type="submit">Registrar</button>
                <button id="btnVolverInicio">Volver</button>
            </div>
        </div>
        <div class="contenedorFormulario">
            <div class="iniciarUsuaro">
                <h1>Iniciar Sesión</h1>
                <input type="text">
                <input type="password">  
                <div>
                    <input type="checkbox">
                    <label for="">Recordar contraseña</label>
                    <a href="">Olvidé mi contraseña</a>
                </div>
                <button>Iniciar</button>
                <button id="btnRegistrar">Registrar</button>
                <button><img src="/images/descarga1.png" alt="logoGoogle">Registrar con Google</button>
            </div>
        </div>

        <div class="contenedorSaludo">
            <div class="saludoIniciar saludo">
                <h1>Bienvenido</h1>
                <p>Página de materiales escolares del ministerio de educación pública</p>
                <img src="/images/estudiantes_mep1.png" alt="imagenEstudiantes">
                <img src="/images/logo1.png" alt="logoMepRegistro">
            </div>
            <div class="saludoRegistrar saludo">
                <h1>Página de registro</h1>
                <p>En este apartado podrá registrar usuarios en la página</p>
                <img src="/images/estudiantes_mep1.png" alt="imagenEstudiantes">
                <img src="/images/logo1.png" alt="logoMepRegistro">
            </div>
        </div>
    </div>
</div>

<script>
    const contenedorIniciar = document.querySelector(".contenedorIniciar");
    const btnRegistrar = document.getElementById("btnRegistrar");
    const btnVolverInicio = document.getElementById("btnVolverInicio");

    btnRegistrar.addEventListener("click", ()=>{
        contenedorIniciar.classList.add("toggle");
    });

    btnVolverInicio.addEventListener("click", ()=>{
        contenedorIniciar.classList.remove("toggle");
    });
</script>
